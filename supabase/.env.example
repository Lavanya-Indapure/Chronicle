# Copy to supabase/.env (git-ignored) and fill in. Never commit the real file.
#
# Supabase dashboard → Connect → "Session pooler" connection string
# (works over IPv4; the "Direct connection" host is IPv6-only on most plans,
# and the "Transaction pooler" on port 6543 doesn't support pg_dump).
# Replace [YOUR-PASSWORD] with the database password (Project Settings →
# Database → reset it there if you don't have it).
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
